# =========================================================================
# Google Maps Platform Configuration for KumbhSupply-AI
# =========================================================================
# Enable "Routes API" (and optionally "Maps JavaScript API") in Google Cloud Console
# Obtain API key from: https://console.cloud.google.com/google/maps-apis/credentials
# Restrict key by HTTP Referrer for web usage.

# Vite frontend environment variable
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Server-side environment variable (if running SSR or proxy server)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
